{
  "name": "limenn",
  "homepage": "https://limenn.io",
  "repository": "github:jatlantic/Limenn",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome and Firefox extension that removes personal data from prompts and files on your device before they reach ChatGPT, Claude or Grok, and restores it in the answers.",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "build": "vite build && node scripts/build-content.mjs",
    "build:firefox": "node scripts/run-target.mjs firefox npm run build",
    "build:firefox-lite": "node scripts/run-target.mjs firefox-lite npm run build",
    "fetch-models": "node scripts/fetch-models.mjs",
    "release": "node scripts/release.mjs",
    "release:firefox": "node scripts/run-target.mjs firefox node scripts/release.mjs",
    "release:firefox-lite": "node scripts/run-target.mjs firefox-lite node scripts/release.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "fixtures": "node scripts/make-fixture.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^7.0.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
